Enum "txn_agg"."transaction_type" {
  "card"
  "debit_order"
  "eft"
  "internal_transfer"
}

Enum "txn_agg"."credit_debit_indicator" {
  "credit"
  "debit"
}

Enum "txn_agg"."transaction_status" {
  "completed"
  "pending"
  "reversed"
  "failed"
}

Table "txn_agg"."categories" {
  "category_id" SMALLINT [pk, increment]
  "category" TEXT [unique, not null]
  "label" TEXT [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
}

Table "txn_agg"."rule_sets" {
  "version" int [pk]
  "created_at" timestamptz [not null, default: `now()`]
  "notes" text [not null]
}

Table "txn_agg"."categorization_rules" {
  "categorization_rule_id" int [pk, increment]
  "ruleset_version" int [not null]
  "priority" int [not null]
  "matcher_type" text [not null, check: `matcher_type IN ('mcc','keyword','source_transaction_type','source_credit_debit_indicator','source_default')`]
  "pattern" text [not null]
  "category_id" smallint [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (ruleset_version, priority) [unique]
  }
}

Table "txn_agg"."user_category_overrides" {
  "user_id" uuid [not null]
  "from_category_id" smallint [not null]
  "to_category_id" smallint [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "archived_at" timestamptz

  Checks {
    `from_category_id <> to_category_id`
  }

  Indexes {
    (user_id, from_category_id) [pk]
  }
}

Table "txn_agg"."user_transaction_overrides" {
  "user_id" uuid [not null]
  "transaction_id" uuid [not null]
  "occurred_at" timestamptz [not null]
  "category_id" smallint [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "archived_at" timestamptz

  Indexes {
    (transaction_id, occurred_at) [pk]
  }
}

Table "txn_agg"."transactions" {
  "transaction_id" uuid [not null, default: `uuidv7()`]
  "user_id" uuid [not null]
  "account_id" uuid [not null]
  "transaction_type" txn_agg.transaction_type [not null]
  "external_id" text [not null]
  "occurred_at" timestamptz [not null]
  "credit_debit_indicator" txn_agg.credit_debit_indicator [not null]
  "status" txn_agg.transaction_status [not null]
  "amount_minor" bigint [not null, check: `amount_minor > 0`]
  "currency" char(3) [not null]
  "long_description" text
  "short_description" text
  "category_id" smallint [not null]
  "rule_version" int [not null]
  "rule_priority" int
  "ingested_at" timestamptz [not null, default: `now()`]
  "metadata" jsonb

  Indexes {
    (transaction_id, occurred_at) [pk]
    (transaction_type, external_id, occurred_at) [unique]
    (user_id, occurred_at, transaction_id) [name: "idx_tx_user_read"]
  }
}


# pyenv
#   For a library or package, you might want to ignore these files since the Python version is individual.
#   For an application or deployment, you might want to check these files in.
# .python-version

# pipenv
#   According to pypa/pipenv#118, it is recommended to include Pipfile.lock in version control.
#   However, if you're building a library, you should ignore it.
#Pipfile.lock

# poetry
#   Similar to Pipenv, poetry lock file should be tracked in applications, but can be ignored in libraries.
#poetry.lock

# pdm
#   Similar to Pipenv and Poetry, pdm lock file should be tracked in applications, but can be ignored in libraries.
#pdm.lock


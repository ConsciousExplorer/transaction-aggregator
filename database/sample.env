# Copy to .env for the scripts against the `make up` stack: npm run migrate
# applies the migrations through the published port. Every setting
# drizzle.config.ts reads; none has a default.

# Postgres, as the admin login the migrations run as
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=txn_agg
DATABASE_USER=admin

# The password is a file in SECRET_DIR
SECRET_DIR=./secrets
DATABASE_PASSWORD_SECRET_NAME=admin_password

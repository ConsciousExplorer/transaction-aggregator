    {
      "type": "stat",
      "title": "Rows inserted (metrics)",
      "description": "Sum of the consumers' rows_inserted_total right now (panel time: last 5 minutes). Must equal Rows in table. Counters reset when a consumer restarts, so they agree only after make clean, then make up-all.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",

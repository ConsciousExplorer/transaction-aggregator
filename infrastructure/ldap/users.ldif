# UI users for kafbat-ui (LDAP auth). kafbat has no static multi-user store,
# so this tiny directory provides them: group membership drives UI permissions
# via infrastructure/kafbat/rbac.yml (admins = full access, viewers = read-only).
dn: ou=people,dc=txn,dc=local
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=txn,dc=local
objectClass: organizationalUnit
ou: groups

dn: uid=admin,ou=people,dc=txn,dc=local
objectClass: inetOrgPerson
cn: Admin
sn: Admin
uid: admin
userPassword: admin

dn: uid=viewer,ou=people,dc=txn,dc=local
objectClass: inetOrgPerson
cn: Viewer
sn: Viewer
uid: viewer
userPassword: viewer

dn: cn=admins,ou=groups,dc=txn,dc=local
objectClass: groupOfNames
cn: admins
member: uid=admin,ou=people,dc=txn,dc=local

dn: cn=viewers,ou=groups,dc=txn,dc=local
objectClass: groupOfNames
cn: viewers
member: uid=viewer,ou=people,dc=txn,dc=local

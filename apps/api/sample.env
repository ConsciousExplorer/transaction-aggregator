# Copy to .env for `npm start`. Every other setting has a default in src/config.ts.

#   off   no query logging
#   sql   log each statement drizzle sends, with its values filled in, ready to
#         paste into DBeaver or psql
#   plan  also log its plan: EXPLAIN (ANALYZE, BUFFERS) for a read, which runs it
#         a second time; plain EXPLAIN for a write, which does not run it
DATABASE_QUERY_LOG=off

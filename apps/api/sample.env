# Copy to .env for `npm start` against the `make up` stack. Every setting
# src/config.ts reads; the values reach the stack from the host.

# Server. The compose api already holds port 8083.
HOST=0.0.0.0
HTTP_PORT=3000
ENABLE_SWAGGER=true

# Logging. LOG_REDACTED_FIELDS is comma-separated and adds to the card number
# fields, which are always redacted.
LOG_LEVEL=info
LOG_REDACTED_FIELDS=
LOG_REDACT_DEPTH=3

# Secrets are files in this folder
SECRET_DIR=./secrets

# Postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=txn_agg
DATABASE_USER=api_write
DATABASE_PASSWORD_SECRET_NAME=api_write_password
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# Pool timeouts in milliseconds. The statement timeout (server) fires before
# the query timeout (client), which is there for a connection that never answers.
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=6000
DATABASE_KEEP_ALIVE_DELAY_MS=10000

# Query logging: either one logs each statement drizzle sends; neither logs
# nothing.
#   _SQL   with its values filled in, ready to paste into DBeaver or psql
#   _PLAN  with its plan: EXPLAIN (ANALYZE, BUFFERS) for a read, which runs it a
#          second time; plain EXPLAIN for a write, which does not run it
DATABASE_QUERY_LOG_SQL=false
DATABASE_QUERY_LOG_PLAN=false

# Keycloak, published on localhost:8086. Tokens carry this issuer.
AUTH_JWKS_URI=http://localhost:8086/realms/txn-api/protocol/openid-connect/certs
AUTH_ISSUER=http://localhost:8086/realms/txn-api
AUTH_AUDIENCE=txn-api

# Widest fromDateTime → toDateTime span for the list and summary, in days
WINDOW_MAX_DAYS=366

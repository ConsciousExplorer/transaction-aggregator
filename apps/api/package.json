{
	"name": "api",
	"version": "1.0.0",
	"description": "Transaction API for client transactions",
	"license": "ISC",
	"author": "edwinstoltz.es@gmail.com",
	"type": "module",
	"main": "app.ts",
	"scripts": {
		"check": "npx tsc",
		"check-circular-deps": "npx madge --circular --extensions ts --warning src/",
		"lib:update": "npx npm-check-updates --interactive --format group",
		"lib:audit": "npm audit",
		"format": "npx @biomejs/biome format src/",
		"lint": "npx @biomejs/biome check --write src/",
		"start": "node --env-file=.env src/app.ts",
		"fms": "npm run biome:migrate && npm run lint && npm run format && npm run check",
		"test": "node --test 'src/**/*.test.ts' --test-skip-pattern integration",
		"test:integration": "node --env-file=.env --test 'test/integration/**/*.test.ts'",
		"biome:migrate": "npx @biomejs/biome migrate --write"
	},
	"imports": {
		"#src/*": "./src/*",
		"#types": "./src/types/*",
		"#domain": "./src/domain/*",
		"#generated": "./src/generated/*",
		"#handlers": "./src/handlers/*",
		"#integrations": "./src/integrations/*",
		"#schemas": "./src/schemas/*",
		"#telemetry": "./src/telemetry/*",
		"#errors": "./src/errors/*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/node": "24.x",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@fastify/swagger": "9.8.1",
		"@fastify/swagger-ui": "6.1.1",
		"@fastify/type-provider-zod": "1.0.0",
		"fastify": "^5.12.1",
		"fastify-plugin": "6.0.0",
		"pino-pretty": "^13.1.3",
		"zod": "^4.4.3"
	}
}

{
	"name": "consumer",
	"version": "1.0.0",
	"description": "A consumer that is responsible for categorizing transactions and persisting them to postgres",
	"license": "ISC",
	"author": "Edwin Stoltz",
	"type": "module",
	"main": "src/app.ts",
	"scripts": {
		"precheck": "npx madge --circular --extensions ts --warning src/",
		"check": "npx tsc",
		"lib:update": "npx npm-check-updates --interactive --format group",
		"lib:audit": "npx audit-ci --config ./audit-ci.json",
		"start": "node --env-file=.env src/app.ts | pino-pretty --colorize",
		"fms": "npm run biome:migrate && npm run lint && npm run format && npm run check",
		"format": "npx @biomejs/biome format src/",
		"lint": "npx @biomejs/biome check --write . && npm run spell",
		"spell": "cspell \"**/*.{ts,js}\"",
		"schema:generate": "node scripts/generate-avro-types.ts",
		"schema:check": "node scripts/check-schema-compatibility.ts",
		"test:unit": "LOG_LEVEL=silent node --test 'src/**/*.test.ts' --test-skip-pattern integration",
		"test:integration": "LOG_LEVEL=silent node --env-file=test.env --test 'test/integration/**/*.test.ts'",
		"biome:migrate": "npx @biomejs/biome migrate --write",
		"drizzle:pull-schema": "npx drizzle-kit pull --config=drizzle.config.ts && node scripts/cleanup-drizzle-pull.ts",
		"drizzle:studio": "npx drizzle-kit studio --port=3000 --config=drizzle.config.ts"
	},
	"imports": {
		"#src/*": "./src/*",
		"#types": "./src/types/*",
		"#services": "./src/services/*",
		"#generated": "./src/generated/*",
		"#integrations": "./src/integrations/*",
		"#schemas": "./src/schemas/*",
		"#telemetry": "./src/telemetry/*",
		"#errors": "./src/errors/*"
	},
	"madge": {
		"detectiveOptions": {
			"ts": {
				"skipTypeImports": true
			}
		},
		"tsConfig": {
			"compilerOptions": {
				"module": "NodeNext",
				"moduleResolution": "NodeNext"
			}
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "24.x",
		"@types/pg": "^8.23.1",
		"audit-ci": "7.1.0",
		"avro-typescript": "1.3.0",
		"cspell": "10.4.0",
		"drizzle-kit": "0.31.11",
		"pino-pretty": "^13.2.0",
		"testcontainers": "12.2.1",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/exporter-trace-otlp-http": "0.223.0",
		"@opentelemetry/resources": "2.12.0",
		"@opentelemetry/sdk-trace-node": "2.12.0",
		"@opentelemetry/semantic-conventions": "1.43.0",
		"@platformatic/kafka": "^2.14.0",
		"@prometheus-io/client": "0.16.1",
		"avsc": "^5.7.9",
		"awilix": "13.0.5",
		"drizzle-orm": "0.45.4",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	}
}

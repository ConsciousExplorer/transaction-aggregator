{
	"name": "consumer",
	"version": "1.0.0",
	"description": "A consumer that is responsible for categorizing transactions and persising them to postgres",
	"license": "ISC",
	"author": "Edwin Stoltz",
	"type": "module",
	"main": "src/app.ts",
	"scripts": {
		"check-circular-deps": "npx madge --circular src/",
		"lib:update": "npx npm-check-updates --interactive --format group",
		"lib:audit": "npm audit",
		"start": "node --env-file=.env src/app.ts",
		"fmc": "npm run lint && npm run format",
		"format": "npx @biomejs/biome format src/",
		"lint": "npx @biomejs/biome check --write src/",
		"scripts:generate-avro": "node scripts/generate-avro-types.ts",
		"test": "node --test 'src/**/*.test.ts' --test-skip-pattern integration",
		"test:integration": "node --env-file=.env --test 'test/integration/**/*.test.ts'",
		"biome:migrate": "npx @biomejs/biome migrate --write"
	},
	"imports": {
		"#src/*": "./src/*",
		"#types": "./src/types/*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@types/node": "24.x",
		"@types/pg": "^8.20.4",
		"avro-typescript": "1.3.0",
		"pino-pretty": "^13.1.3",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@platformatic/kafka": "^2.8.0",
		"avsc": "^5.7.9",
		"pg": "^8.22.0",
		"pino": "^10.3.1",
		"zod": "^4.4.3"
	}
}

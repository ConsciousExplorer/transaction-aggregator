{
	"name": "consumer",
	"version": "1.0.0",
	"description": "A consumer that is responsible for categorizing transactions and persisting them to postgres",
	"license": "ISC",
	"author": "Edwin Stoltz",
	"type": "module",
	"main": "src/app.ts",
	"scripts": {
		"precheck": "npx madge --circular --extensions ts --warning src/",
		"check": "npx tsc",
		"lib:update": "npx npm-check-updates --interactive --format group",
		"lib:audit": "npm audit",
		"start": "node --env-file=.env src/app.ts",
		"fms": "npm run biome:migrate && npm run lint && npm run format && npm run check",
		"format": "npx @biomejs/biome format src/",
		"lint": "npx @biomejs/biome check --write src/ && npm run lint:spelling",
		"lint:spelling": "cspell \"**/*.{ts,js}\"",
		"schema:generate": "node scripts/generate-avro-types.ts",
		"test": "LOG_LEVEL=silent node --test 'src/**/*.test.ts' --test-skip-pattern integration",
		"test:integration": "node --env-file=.env --test 'test/integration/**/*.test.ts'",
		"biome:migrate": "npx @biomejs/biome migrate --write",
		"drizzle:pull-schema": "npx drizzle-kit pull --config=drizzle.config.ts && node scripts/cleanup-drizzle-pull.ts",
		"drizzle:studio": "npx drizzle-kit studio --port=3000 --config=drizzle.config.ts"
	},
	"imports": {
		"#src/*": "./src/*",
		"#types": "./src/types/*",
		"#services": "./src/services/*",
		"#generated": "./src/generated/*",
		"#integrations": "./src/integrations/*",
		"#schemas": "./src/schemas/*",
		"#telemetry": "./src/telemetry/*",
		"#errors": "./src/errors/*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "24.x",
		"@types/pg": "^8.23.1",
		"avro-typescript": "1.3.0",
		"cspell": "10.3.6",
		"drizzle-kit": "0.31.11",
		"pino-pretty": "^13.1.3",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/exporter-trace-otlp-http": "0.222.0",
		"@opentelemetry/resources": "2.11.0",
		"@opentelemetry/sdk-trace-node": "2.11.0",
		"@opentelemetry/semantic-conventions": "1.43.0",
		"@platformatic/kafka": "^2.13.0",
		"@prometheus-io/client": "0.16.1",
		"avsc": "^5.7.9",
		"awilix": "13.0.5",
		"drizzle-orm": "0.45.3",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"zod": "^4.6.5"
	}
}

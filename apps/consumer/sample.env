# Copy to .env for `npm start` against the `make up` stack. Every setting
# src/config.ts reads; the values reach the stack from the host.

# App. Host port 8080 belongs to kafbat-ui.
APP_NAME="transaction-aggregator"
HOST=0.0.0.0
PORT=6000

# Which source this instance consumes: picks the normaliser and the group id
# (transaction-consumer-<type>). The topic is named explicitly.
TRANSACTION_TYPE=eft
KAFKA_TOPIC=transactions.eft

# Logging. LOG_REDACTED_FIELDS is comma-separated and adds to the card number
# fields, which are always redacted.
LOG_LEVEL=info
LOG_REDACTED_FIELDS=
LOG_REDACT_DEPTH=3

# Secrets are files in this folder
SECRET_DIR=./secrets

# Postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=txn_agg
DATABASE_USER=kafka_consumer
DATABASE_PASSWORD_SECRET_NAME=consumer_database_password
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=3

# Schema Registry
SCHEMA_REGISTRY_URL=http://localhost:8081

# Kafka, through the EXTERNAL listener the broker publishes for host clients
KAFKA_BROKERS=localhost:9092
KAFKA_USERNAME=consumer
KAFKA_PASSWORD_SECRET_NAME=consumer_kafka_password
KAFKA_SASL_MECHANISM=SCRAM-SHA-512

# Group membership. The library defaults (60s session) stall restarts.
# Heartbeat at most a third of the session; rebalance at least the session;
# request longer than the rebalance.
KAFKA_SESSION_TIMEOUT_MS=15000
KAFKA_HEARTBEAT_INTERVAL_MS=5000
KAFKA_REBALANCE_TIMEOUT_MS=30000
KAFKA_REQUEST_TIMEOUT_MS=40000

# Fetch and batching
KAFKA_MAX_WAIT_TIME_MS=1000
KAFKA_BATCH_SIZE=100
KAFKA_BATCH_LINGER_MS=2000
KAFKA_READ_MODE=committed

# How often lag is measured for kafka_consumers_lags
KAFKA_LAG_MONITORING_INTERVAL_MS=10000

# Tracing stays off locally unless set to false
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=consumer

# Local development against the stack `make up` started. Copy to .env: `next dev` reads it.
# Every value here is a development value; compose sets its own (infrastructure/docker-compose.yaml).

# Where the browser reaches the portal; redirects and the Origin check use it
PUBLIC_BASE_URL=http://localhost:8084

# The transaction API
API_BASE_URL=http://localhost:8083

# Keycloak: the public URL is the issuer and where the browser is sent; the internal URL is
# where the BFF calls it itself. Outside Docker they are the same.
KEYCLOAK_PUBLIC_URL=http://localhost:8086
KEYCLOAK_INTERNAL_URL=http://localhost:8086
KEYCLOAK_REALM=txn-api

# The person's login: the browser-facing client
PORTAL_CLIENT_ID=banking-portal-web
PORTAL_CLIENT_SECRET=banking-portal-web-secret

# The BFF's own identity towards the API (tx:read tx:write)
SERVICE_CLIENT_ID=banking-portal
SERVICE_CLIENT_SECRET=banking-portal-secret

# Seals the session cookie; at least 32 characters
SESSION_SECRET=portal-dev-session-secret-change-me-0123456789

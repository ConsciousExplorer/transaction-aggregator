{
  "type": "record",
  "name": "DebitOrderTransaction",
  "namespace": "transactions",
  "partitionKey": "customerId",
  "doc": "Recurring collection initiated by a creditor against an authorised mandate.",
  "fields": [
    {
      "name": "transactionId",
      "type": { "type": "string", "logicalType": "uuid" }
    },
    {
      "name": "sourceType",
      "type": "string",
      "arg.properties": { "options": ["debitOrder"] }
    },
    {
      "name": "customerId",
      "type": { "type": "string", "logicalType": "uuid" },
      "arg.properties": { "pool": 50 }
    },
    {
      "name": "mandateId",
      "type": { "type": "string", "logicalType": "uuid" }
    },
    {
      "name": "category",
      "type": "string",
      "doc": "Generation hint only — consumer derives category from creditorName. Consumer Zod schema should strip this field.",
      "arg.properties": {
        "options": [
          "INSURANCE",
          "INSURANCE",
          "UTILITIES",
          "SUBSCRIPTIONS",
          "GYM",
          "SCHOOL_FEES",
          "LOAN_REPAYMENT"
        ]
      }
    },
    {
      "name": "creditorName",
      "type": "string",
      "arg.properties": {
        "rules": [
          {
            "when": { "field": "category", "equals": "INSURANCE" },
            "then": {
              "options": [
                "Discovery Life",
                "Old Mutual",
                "Sanlam",
                "Momentum",
                "Outsurance",
                "Hollard"
              ]
            }
          },
          {
            "when": { "field": "category", "equals": "UTILITIES" },
            "then": {
              "options": [
                "Eskom",
                "City of Cape Town",
                "Joburg Water",
                "Telkom"
              ]
            }
          },
          {
            "when": { "field": "category", "equals": "SUBSCRIPTIONS" },
            "then": {
              "options": [
                "DStv",
                "Netflix SA",
                "Showmax",
                "Spotify",
                "Apple Music"
              ]
            }
          },
          {
            "when": { "field": "category", "equals": "GYM" },
            "then": {
              "options": ["Virgin Active", "Planet Fitness", "Sweat1000"]
            }
          },
          {
            "when": { "field": "category", "equals": "SCHOOL_FEES" },
            "then": { "options": ["Curro", "Reddam House", "Crawford"] }
          },
          {
            "when": { "field": "category", "equals": "LOAN_REPAYMENT" },
            "then": { "options": ["Capitec Loans", "Wesbank", "MFC"] }
          }
        ]
      }
    },
    {
      "name": "creditorAbbrevName",
      "type": "string",
      "arg.properties": { "ref": "creditorName" }
    },
    {
      "name": "collectionType",
      "type": "string",
      "arg.properties": {
        "options": ["early", "tracking", "standard", "standard"]
      }
    },
    {
      "name": "frequency",
      "type": "string",
      "arg.properties": {
        "options": ["monthly", "monthly", "monthly", "quarterly", "annual"]
      }
    },
    {
      "name": "amount",
      "type": "long",
      "doc": "Amount in ZAC (South African cents). Divide by 100 for display in ZAR.",
      "arg.properties": {
        "rules": [
          {
            "when": { "field": "category", "equals": "INSURANCE" },
            "then": { "range": { "min": 25000, "max": 450000 } }
          },
          {
            "when": { "field": "category", "equals": "UTILITIES" },
            "then": { "range": { "min": 50000, "max": 500000 } }
          },
          {
            "when": { "field": "category", "equals": "SUBSCRIPTIONS" },
            "then": { "range": { "min": 5900, "max": 99900 } }
          },
          {
            "when": { "field": "category", "equals": "GYM" },
            "then": { "range": { "min": 19900, "max": 89900 } }
          },
          {
            "when": { "field": "category", "equals": "SCHOOL_FEES" },
            "then": { "range": { "min": 250000, "max": 2500000 } }
          },
          {
            "when": { "field": "category", "equals": "LOAN_REPAYMENT" },
            "then": { "range": { "min": 80000, "max": 1500000 } }
          }
        ]
      }
    },
    {
      "name": "currency",
      "type": "string",
      "arg.properties": { "options": ["ZAR"] }
    },
    {
      "name": "transactionType",
      "type": "string",
      "arg.properties": { "options": ["debit"] }
    },
    {
      "name": "description",
      "type": "string",
      "arg.properties": { "template": "Debit order: {creditorName}" }
    },
    {
      "name": "status",
      "type": "string",
      "doc": "Higher REVERSED ratio — failed debit order collections are common.",
      "arg.properties": {
        "options": [
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "REVERSED",
          "REVERSED",
          "FAILED",
          "FAILED"
        ]
      }
    },
    {
      "name": "timestamp",
      "type": { "type": "long", "logicalType": "timestamp-millis" },
      "arg.properties": { "range": { "min": "-30d", "max": "now" } }
    }
  ]
}

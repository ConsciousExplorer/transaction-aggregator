{
  "type": "record",
  "name": "EftTransaction",
  "namespace": "transactions",
  "partitionKey": "customerId",
  "doc": "Electronic Funds Transfer — inter-bank. debit = outbound push to a beneficiary; credit = inbound receipt (e.g. salary), where the beneficiary* fields describe the counterparty (the payer).",
  "fields": [
    {
      "name": "transactionId",
      "type": { "type": "string", "logicalType": "uuid" }
    },
    {
      "name": "sourceType",
      "type": "string",
      "arg.properties": { "options": ["eft"] }
    },
    {
      "name": "customerId",
      "type": { "type": "string", "logicalType": "uuid" },
      "arg.properties": { "pool": { "size": 5000, "seed": "customers-v1" } }
    },
    {
      "name": "accountId",
      "type": { "type": "string", "logicalType": "uuid" },
      "doc": "Customer account the transaction occurred on.",
      "arg.properties": { "pool": { "size": 3, "per": "customerId", "seed": "accounts-v1" } }
    },
    {
      "name": "beneficiaryName",
      "type": "string",
      "arg.properties": { "faker": "name" }
    },
    {
      "name": "beneficiaryAccountNumber",
      "type": "string",
      "arg.properties": {
        "faker": "numerify",
        "args": { "text": "##########" }
      }
    },
    {
      "name": "beneficiaryBank",
      "type": "string",
      "arg.properties": {
        "options": [
          "ABSA",
          "Standard Bank",
          "FNB",
          "Nedbank",
          "Capitec",
          "Investec",
          "TymeBank",
          "African Bank",
          "Discovery Bank"
        ]
      }
    },
    {
      "name": "branchCode",
      "type": "string",
      "arg.properties": { "faker": "numerify", "args": { "text": "######" } }
    },
    {
      "name": "reference",
      "type": "string",
      "arg.properties": { "faker": "sentence", "args": { "nb_words": 3 } }
    },
    {
      "name": "amount",
      "type": "long",
      "doc": "Amount in ZAC (South African cents). Divide by 100 for display in ZAR.",
      "arg.properties": { "range": { "min": 10000, "max": 5000000 } }
    },
    {
      "name": "currency",
      "type": "string",
      "arg.properties": { "options": ["ZAR"] }
    },
    {
      "name": "transactionType",
      "type": "string",
      "arg.properties": { "options": ["debit", "debit", "debit", "credit"] }
    },
    {
      "name": "clearingType",
      "type": "string",
      "arg.properties": {
        "options": ["standard", "standard", "standard", "same-day"]
      }
    },
    {
      "name": "description",
      "type": "string",
      "arg.properties": {
        "rules": [
          {
            "when": { "field": "transactionType", "equals": "debit" },
            "then": { "template": "EFT to {beneficiaryName}" }
          },
          {
            "when": { "field": "transactionType", "equals": "credit" },
            "then": { "template": "Salary payment - {beneficiaryName}" }
          }
        ]
      }
    },
    {
      "name": "status",
      "type": "string",
      "arg.properties": {
        "options": [
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "PENDING",
          "PENDING",
          "PENDING",
          "REVERSED",
          "REVERSED",
          "FAILED"
        ]
      }
    },
    {
      "name": "timestamp",
      "type": { "type": "long", "logicalType": "timestamp-millis" },
      "arg.properties": { "range": { "min": "-30d", "max": "now" } }
    }
  ]
}

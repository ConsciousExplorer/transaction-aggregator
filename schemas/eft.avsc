{
  "type": "record",
  "name": "EftTransaction",
  "namespace": "transactions",
  "partitionKey": "customerId",
  "doc": "Electronic Funds Transfer — inter-bank. debit = outbound push to a beneficiary; credit = inbound receipt (e.g. salary), where the beneficiary* fields describe the counterparty (the payer).",
  "fields": [
    {
      "name": "transactionId",
      "type": { "type": "string", "logicalType": "uuid" }
    },
    {
      "name": "transactionType",
      "type": { "type": "enum", "name": "TransactionType", "symbols": ["card", "eft", "loan", "debit_order", "internal_transfer"] },
      "doc": "What kind of transaction this is, with the same values as the database's transaction_type.",
      "arg.properties": { "options": ["eft"] }
    },
    {
      "name": "customerId",
      "type": { "type": "string", "logicalType": "uuid" },
      "arg.properties": { "pool": { "size": 5000, "seed": "customers-v1" } }
    },
    {
      "name": "accountId",
      "type": { "type": "string", "logicalType": "uuid" },
      "doc": "Customer account the transaction occurred on.",
      "arg.properties": { "pool": { "size": 3, "per": "customerId", "seed": "accounts-v1" } }
    },
    {
      "name": "beneficiaryName",
      "type": "string",
      "arg.properties": { "faker": "name" }
    },
    {
      "name": "beneficiaryAccountNumber",
      "type": "string",
      "arg.properties": {
        "faker": "numerify",
        "args": { "text": "##########" }
      }
    },
    {
      "name": "beneficiaryBank",
      "type": "string",
      "arg.properties": {
        "options": [
          "ABSA",
          "Standard Bank",
          "FNB",
          "Nedbank",
          "Capitec",
          "Investec",
          "TymeBank",
          "African Bank",
          "Discovery Bank"
        ]
      }
    },
    {
      "name": "branchCode",
      "type": "string",
      "arg.properties": { "faker": "numerify", "args": { "text": "######" } }
    },
    {
      "name": "reference",
      "type": "string",
      "arg.properties": { "faker": "sentence", "args": { "nb_words": 3 } }
    },
    {
      "name": "amount",
      "type": "long",
      "doc": "Amount in cents, the minor unit of ZAR. Divide by 100 for rands.",
      "arg.properties": { "range": { "min": 10000, "max": 5000000 } }
    },
    {
      "name": "currency",
      "type": "string",
      "arg.properties": { "options": ["ZAR"] }
    },
    {
      "name": "creditDebitIndicator",
      "type": { "type": "enum", "name": "CreditDebitIndicator", "symbols": ["credit", "debit"] },
      "doc": "Whether the money came into the customer's account (credit) or left it (debit), as a bank statement shows it. The amount is always positive.",
      "arg.properties": { "options": ["debit", "debit", "debit", "credit"] }
    },
    {
      "name": "clearingType",
      "type": "string",
      "arg.properties": {
        "options": ["standard", "standard", "standard", "same-day"]
      }
    },
    {
      "name": "description",
      "type": "string",
      "arg.properties": {
        "rules": [
          {
            "when": { "field": "creditDebitIndicator", "equals": "debit" },
            "then": { "template": "EFT to {beneficiaryName}" }
          },
          {
            "when": { "field": "creditDebitIndicator", "equals": "credit" },
            "then": { "template": "Salary payment - {beneficiaryName}" }
          }
        ]
      }
    },
    {
      "name": "status",
      "type": "string",
      "arg.properties": {
        "options": [
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "COMPLETED",
          "PENDING",
          "PENDING",
          "PENDING",
          "REVERSED",
          "REVERSED",
          "FAILED"
        ]
      }
    },
    {
      "name": "timestamp",
      "type": { "type": "long", "logicalType": "timestamp-millis" },
      "arg.properties": { "range": { "min": "-548d", "max": "now" } }
    }
  ]
}
